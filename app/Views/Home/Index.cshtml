@model MoodleFrontendModel
@{
    ViewData["Title"] = "Moodle Integration Portal";
}

<div class="container mt-5">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Enroll Students Section -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h2 class="h5 mb-0">Enroll Students</h2>
        </div>
        <div class="card-body">
            <form asp-action="Enroll" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">Students Excel File</label>
                    <input type="file" name="studentsFile" class="form-control" accept=".xlsx,.xls" required>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Course ID</label>
                        <select name="courseId" class="form-select" asp-items="Model.CourseList"></select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Role ID</label>
                        <input type="number" name="roleId" class="form-control" value="5" required>
                    </div>
                    <div class="col-md-4">
                        <div class="form-check mt-4">
                            <input class="form-check-input" type="checkbox" name="generateQr" value="true" id="qrCheck">
                            <label class="form-check-label" for="qrCheck">Generate QR Codes</label>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Enroll Students</button>
            </form>
        </div>
    </div>

    <!-- Grade Student Section -->
    <div class="card mb-4">
        <div class="card-header bg-success text-white">
            <h2 class="h5 mb-0">Update Student Grade</h2>
        </div>
        <div class="card-body">
            <form asp-action="Grade" method="post">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Student ID</label>
                        <input type="number" name="studentId" class="form-control" required>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Course ID</label>
                        <select name="courseId" class="form-select" asp-items="Model.CourseList"></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Grade</label>
                        <input type="number" step="0.01" name="grade" class="form-control" required>
                    </div>
                    <div class="col-md-3 align-self-end">
                        <button type="submit" class="btn btn-success">Update Grade</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Courses List Section -->
    <div class="card">
        <div class="card-header bg-info text-white">
            <h2 class="h5 mb-0">Available Courses</h2>
        </div>
        <div class="card-body">
            @if (!Model.Courses.Any())
            {
                <div class="alert alert-info">
                    No courses available. Please check the API connection.
                </div>
            }
            else
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Course ID</th>
                            <th>Course Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model.Courses)
                        {
                            <tr>
                                <td>@course.CourseId</td>
                                <td>@course.CourseName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-hide alerts after 5 seconds
        setTimeout(function() {
            $('.alert').alert('close');
        }, 5000);
    </script>
}